# Copy to backend/.env (git-ignored) for local runs of the chat backend.
CONTROL_API_ENABLED=true
AWS_PROFILE=regobs
AWS_REGION=ap-southeast-2
ECS_CLUSTER=cloudpilot-ai-cluster
ECS_SERVICE=cloudpilot-ai-service

# Natural-language interpreter: auto (OpenAI if a key is set, else rules) | rules
PARSER_MODE=auto
OPENAI_API_KEY=sk-...your key...
OPENAI_MODEL=gpt-5-mini
