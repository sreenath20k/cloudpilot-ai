{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndUpdateTheCloudPilotService",
      "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:UpdateService"],
      "Resource": "arn:aws:ecs:ap-southeast-2:*:service/cloudpilot-ai-cluster/cloudpilot-ai-service"
    },
    {
      "Sid": "TaskDefinitionRevisions",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTaskDefinition", "ecs:RegisterTaskDefinition", "ecs:TagResource"],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyTheExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/cloudpilot-ai-task-execution-role",
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    }
  ]
}
